# Optional Cesium Ion access token for terrain/imagery.
# Without it, STORMVERSE falls back to free OpenStreetMap raster tiles.
# Get a token at https://ion.cesium.com/
VITE_CESIUM_ION_TOKEN=

# Optional licensed lightning GeoJSON FeatureCollection URL (Point features).
# Leave unset to keep lightning unavailable. See public/samples/lightning.example.geojson.
# VITE_LIGHTNING_GEOJSON_URL=https://example.com/lightning.geojson

